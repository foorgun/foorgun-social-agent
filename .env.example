# Für lokale Tests: kopieren nach .env und ausfüllen (.env wird nie committet).
# In GitHub Actions kommen dieselben Werte aus Settings › Secrets and variables › Actions.

# --- Instagram (Meta Graph API) ---
IG_USER_ID=
IG_ACCESS_TOKEN=
META_GRAPH_VERSION=v23.0
# Öffentliche Basis-URL des media/-Ordners (Instagram lädt die Bilder von dort)
MEDIA_BASE_URL=https://raw.githubusercontent.com/<github-user>/<repo>/main/media

# --- LinkedIn (Community Management API) ---
LINKEDIN_ORG_ID=
LINKEDIN_ACCESS_TOKEN=
# Optional, damit der Token nicht alle 60 Tage manuell erneuert werden muss:
LINKEDIN_REFRESH_TOKEN=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Optional, Format YYYYMM; leer = automatisch
LINKEDIN_VERSION=
